set(STELNET_ASR_VERSION      @STELNET_ASR_INSTALL_VERSION@)
set(STELNET_ASR_BUILD_COMMIT @STELNET_ASR_BUILD_COMMIT@)
set(STELNET_ASR_BUILD_NUMBER @STELNET_ASR_BUILD_NUMBER@)
set(STELNET_ASR_SHARED_LIB   @BUILD_SHARED_LIBS@)

@PACKAGE_INIT@

set_and_check(STELNET_ASR_INCLUDE_DIR "@PACKAGE_STELNET_ASR_INCLUDE_INSTALL_DIR@")
set_and_check(STELNET_ASR_LIB_DIR     "@PACKAGE_STELNET_ASR_LIB_INSTALL_DIR@")
set_and_check(STELNET_ASR_BIN_DIR     "@PACKAGE_STELNET_ASR_BIN_INSTALL_DIR@")

find_package(ggml REQUIRED HINTS ${LLAMA_LIB_DIR}/cmake)

find_library(whisper_LIBRARY whisper
    REQUIRED
    HINTS ${STELNET_ASR_LIB_DIR}
    NO_CMAKE_FIND_ROOT_PATH
)

add_library(whisper UNKNOWN IMPORTED)
set_target_properties(whisper
    PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${STELNET_ASR_INCLUDE_DIR}"
        INTERFACE_LINK_LIBRARIES "ggml::ggml;ggml::ggml-base;"
        IMPORTED_LINK_INTERFACE_LANGUAGES "CXX"
        IMPORTED_LOCATION "${whisper_LIBRARY}"
        INTERFACE_COMPILE_FEATURES cxx_std_11
        POSITION_INDEPENDENT_CODE ON )

check_required_components(whisper)
