STELNET_ASR_IMAGE=stelnet_asr-local:main
STELNET_ASR_IMAGE_CUDA=stelnet_asr-local:main-cuda
STELNET_ASR_PORT=8080
STELNET_ASR_MODEL=/models/model.gguf
STELNET_ASR_BACKEND=
STELNET_ASR_LANGUAGE=auto
STELNET_ASR_AUTO_DOWNLOAD=0
STELNET_ASR_CACHE_DIR=/cache
STELNET_ASR_API_KEYS=
# Optional startup flags, e.g. --frequency-penalty 0.4 for a server-wide default.
# Per-request /v1/audio/transcriptions fields max_tokens, max_new_tokens, and
# frequency_penalty override this for each request.
STELNET_ASR_EXTRA_ARGS=
STELNET_ASR_UID=1000
STELNET_ASR_GID=1000
